{
  "name": "@alexzeng666/dsh-verify",
  "version": "0.1.0",
  "description": "Verifies the agent's work instead of trusting it: run, assert, attribute, report.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "vendor",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "verify",
    "assertion",
    "evidence"
  ],
  "homepage": "https://github.com/alexzeng666/dsh-verify#readme",
  "bugs": {
    "url": "https://github.com/alexzeng666/dsh-verify/issues"
  },
  "license": "MIT",
  "author": "alexzeng666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexzeng666/dsh-verify.git",
    "directory": "packages/dsh-verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@alexzeng666/dsh-quota": "workspace:*",
    "@alexzeng666/dsh-crashlab": "workspace:*",
    "@alexzeng666/dsh-probe": "workspace:*",
    "@alexzeng666/dsh-timelab": "workspace:*"
  },
  "devDependencies": {
    "@alexzeng666/dsh-verify-contract": "workspace:*"
  },
  "peerDependencies": {
